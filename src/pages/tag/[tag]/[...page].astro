---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/PostCard.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { slugifyTag } from '../../../utils/slugifyTag';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts';

export async function getStaticPaths({ paginate }) {
  const allPosts = await getCollection('blog');

  // Build a map of slug -> { displayName, posts[] } so every
  // distinct tag (however it was capitalized/written) gets its
  // own page, sorted newest first.
  const tagMap = new Map();

  for (const post of allPosts) {
    const tags = post.data.tags || [];

    for (const tag of tags) {
      const slug = slugifyTag(tag);

      if (!tagMap.has(slug)) {
        tagMap.set(slug, { displayName: tag, posts: [] });
      }

      tagMap.get(slug).posts.push(post);
    }
  }

  const POSTS_PER_PAGE = 9;
  const paths = [];

  for (const [slug, { displayName, posts }] of tagMap.entries()) {
    const sorted = posts.sort(
      (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    );

    const pages = paginate(sorted, {
      pageSize: POSTS_PER_PAGE,
      params: { tag: slug },
      props: { displayName },
    });

    paths.push(...pages);
  }

  return paths;
}

const { page, displayName } = Astro.props;
const { tag } = Astro.params;

// The sidebar draws on the whole site, not just this tag, so
// readers have somewhere to go once they finish this club's news.
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const shownIds = new Set(page.data.map((post) => post.id));
const sidebarHeadlines = allPosts.filter((post) => !shownIds.has(post.id)).slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`${displayName} News — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .page-header {
        padding: 2.75rem 0 1.75rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 2rem;
      }

      .page-header h1 {
        font-size: 2rem;
        margin: 0 0 0.5rem;
      }

      .back-link {
        display: inline-block;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--pitch);
        text-decoration: none;
      }

      .back-link:hover {
        color: var(--pitch-dark);
      }

      .story-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.75rem 2rem;
        margin-bottom: 2.5rem;
      }

      .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0 3rem;
      }

      .pagination a,
      .pagination span {
        padding: 0.55rem 1.1rem;
        border-radius: 3px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
      }

      .pagination a {
        background: var(--navy);
        color: #ffffff;
      }

      .pagination a:hover {
        background: var(--pitch);
      }

      .pagination .disabled {
        background: #ece9e0;
        color: #a8a496;
      }

      .pagination .page-info {
        color: var(--slate);
        font-weight: 500;
      }

      @media (max-width: 700px) {
        .story-list {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main-wide">
      <div class="page-header">
        <h1>{displayName} News</h1>
        <a class="back-link" href="/blog">← All transfer news</a>
      </div>

      <div class="page-layout">
        <div class="main-col">
          <div class="story-list">
            {page.data.map((post) => (
              <PostCard
                id={post.id}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                heroImage={post.data.heroImage}
                tags={post.data.tags}
              />
            ))}
          </div>

          <div class="pagination">
            {page.url.prev ? (
              <a href={page.url.prev}>← Newer</a>
            ) : (
              <span class="disabled">← Newer</span>
            )}

            <span class="page-info">Page {page.currentPage} of {page.lastPage}</span>

            {page.url.next ? (
              <a href={page.url.next}>Older →</a>
            ) : (
              <span class="disabled">Older →</span>
            )}
          </div>
        </div>

        <Sidebar allPosts={allPosts} headlinePosts={sidebarHeadlines} activeTagSlug={tag} />
      </div>
    </main>
    <Footer />
  </body>
</html>
