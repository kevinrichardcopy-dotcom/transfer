---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

// Astro's built-in pagination: generates /blog/1/, /blog/2/, etc.
// automatically based on how many posts exist and POSTS_PER_PAGE.
export async function getStaticPaths({ paginate }) {
  const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  const POSTS_PER_PAGE = 9;

  return paginate(allPosts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;

// The sidebar's "trending clubs" list is computed from every post,
// and its "more headlines" list picks posts not already shown on
// this page, so the two panels never just repeat the main grid.
const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const shownIds = new Set(page.data.map((post) => post.id));
const sidebarHeadlines = allPosts.filter((post) => !shownIds.has(post.id)).slice(0, 6);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Latest Transfer News — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .page-header {
        padding: 2.75rem 0 1.75rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 2rem;
      }

      .page-header h1 {
        font-size: 2rem;
        margin: 0 0 0.4rem;
      }

      .page-header p {
        color: var(--slate);
        margin: 0;
        font-size: 1rem;
      }

      .story-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.75rem 2rem;
        margin-bottom: 2.5rem;
      }

      .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        padding: 1rem 0 3rem;
      }

      .pagination a,
      .pagination span {
        padding: 0.55rem 1.1rem;
        border-radius: 3px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
      }

      .pagination a {
        background: var(--navy);
        color: #ffffff;
      }

      .pagination a:hover {
        background: var(--pitch);
      }

      .pagination .disabled {
        background: #ece9e0;
        color: #a8a496;
        cursor: default;
      }

      .pagination .page-info {
        color: var(--slate);
        font-weight: 500;
      }

      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--slate);
      }

      @media (max-width: 700px) {
        .story-list {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main-wide">
      <div class="page-header">
        <h1>Latest Transfer News</h1>
        <p>All the confirmed deals, medicals, and negotiations — in one place.</p>
      </div>

      <div class="page-layout">
        <div class="main-col">
          {page.data.length > 0 ? (
            <div class="story-list">
              {page.data.map((post) => (
                <PostCard
                  id={post.id}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  heroImage={post.data.heroImage}
                  tags={post.data.tags}
                />
              ))}
            </div>
          ) : (
            <div class="empty-state">
              <p>No transfer news yet — check back soon.</p>
            </div>
          )}

          <div class="pagination">
            {page.url.prev ? (
              <a href={page.url.prev}>← Newer</a>
            ) : (
              <span class="disabled">← Newer</span>
            )}

            <span class="page-info">Page {page.currentPage} of {page.lastPage}</span>

            {page.url.next ? (
              <a href={page.url.next}>Older →</a>
            ) : (
              <span class="disabled">Older →</span>
            )}
          </div>
        </div>

        <Sidebar allPosts={allPosts} headlinePosts={sidebarHeadlines} />
      </div>
    </main>
    <Footer />
  </body>
</html>
