---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = allPosts[0];
const recent = allPosts.slice(1, 7);
const moreHeadlines = allPosts.slice(7, 13);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hero {
        padding: 3rem 0 2rem;
        text-align: center;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin: 0 0 0.6rem;
        color: #111827;
        letter-spacing: -0.02em;
      }

      .hero p {
        font-size: 1.1rem;
        color: #6b7280;
        max-width: 42rem;
        margin: 0 auto;
      }

      .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin: 2.5rem 0 1.25rem;
      }

      .section-heading h2 {
        font-size: 1.4rem;
        font-weight: 800;
        color: #111827;
        margin: 0;
      }

      .section-heading a {
        font-size: 0.9rem;
        font-weight: 600;
        color: #16a34a;
        text-decoration: none;
      }

      .section-heading a:hover {
        text-decoration: underline;
      }

      .featured-wrap {
        margin-bottom: 1rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #6b7280;
      }

      @media (max-width: 900px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 640px) {
        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main-wide">
      <section class="hero">
        <p style="font-size: 0.85rem; font-weight: 600; color: #16a34a; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.75rem;">
          <span class="live-dot"></span>Live transfer coverage
        </p>
        <h1>{SITE_TITLE}</h1>
        <p>{SITE_DESCRIPTION}</p>
      </section>

      <div class="page-layout">
        <div class="main-col">
          {featured && (
            <section class="featured-wrap">
              <PostCard
                id={featured.id}
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                heroImage={featured.data.heroImage}
                tags={featured.data.tags}
                featured={true}
              />
            </section>
          )}

          {recent.length > 0 && (
            <section>
              <div class="section-heading">
                <h2>Latest news</h2>
                <a href="/blog/1/">View all →</a>
              </div>
              <div class="grid">
                {recent.map((post) => (
                  <PostCard
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    heroImage={post.data.heroImage}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          )}

          {allPosts.length === 0 && (
            <div class="empty-state">
              <p>No transfer news yet — check back soon.</p>
            </div>
          )}
        </div>

        <Sidebar allPosts={allPosts} headlinePosts={moreHeadlines} />
      </div>
    </main>
    <Footer />
  </body>
</html>
