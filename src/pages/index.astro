---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = allPosts[0];
const recent = allPosts.slice(1, 7);
const moreHeadlines = allPosts.slice(7, 13);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hero {
        padding: 2.75rem 0 2rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 2rem;
      }

      .hero .kicker {
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--flare);
        margin-bottom: 0.6rem;
      }

      .hero h1 {
        font-size: clamp(2.1rem, 4vw, 3rem);
        margin: 0 0 0.5rem;
        max-width: 20ch;
      }

      .hero p {
        font-size: 1.05rem;
        color: var(--slate);
        max-width: 42rem;
        margin: 0;
      }

      .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin: 0 0 1.4rem;
      }

      .section-heading h2 {
        font-size: 1.3rem;
        margin: 0;
      }

      .section-heading a {
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--pitch);
        text-decoration: none;
      }

      .section-heading a:hover {
        color: var(--pitch-dark);
      }

      .featured-wrap {
        margin-bottom: 2.5rem;
      }

      .story-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.75rem 2rem;
      }

      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--slate);
      }

      @media (max-width: 700px) {
        .story-list {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main-wide">
      <section class="hero">
        <p class="kicker"><span class="live-dot"></span>Live transfer coverage</p>
        <h1>{SITE_TITLE}</h1>
        <p>{SITE_DESCRIPTION}</p>
      </section>

      <div class="page-layout">
        <div class="main-col">
          {featured && (
            <section class="featured-wrap">
              <PostCard
                id={featured.id}
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                heroImage={featured.data.heroImage}
                tags={featured.data.tags}
                featured={true}
              />
            </section>
          )}

          {recent.length > 0 && (
            <section>
              <div class="section-heading">
                <h2>Latest news</h2>
                <a href="/blog">View all →</a>
              </div>
              <div class="story-list">
                {recent.map((post) => (
                  <PostCard
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    heroImage={post.data.heroImage}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          )}

          {allPosts.length === 0 && (
            <div class="empty-state">
              <p>No transfer news yet — check back soon.</p>
            </div>
          )}
        </div>

        <Sidebar allPosts={allPosts} headlinePosts={moreHeadlines} />
      </div>
    </main>
    <Footer />
  </body>
</html>
