---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = allPosts[0];
const recent = allPosts.slice(1, 7);
const moreHeadlines = allPosts.slice(7, 13);

// Real numbers, not placeholder stats — how many stories are
// actually in the collection and how many clubs they cover.
const clubCount = new Set(allPosts.flatMap((post) => post.data.tags ?? [])).size;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      .hero {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 2rem;
        align-items: end;
        padding: 3rem 0 2.5rem;
      }

      .hero .kicker {
        display: flex;
        align-items: center;
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--signal);
        margin-bottom: 0.75rem;
      }

      .hero h1 {
        font-size: clamp(2.6rem, 6vw, 4.4rem);
        margin: 0 0 0.5rem;
        max-width: 16ch;
      }

      .hero p {
        font-size: 1.05rem;
        color: var(--muted);
        max-width: 38rem;
        margin: 0;
      }

      .stat {
        text-align: right;
        padding-bottom: 0.5rem;
      }

      .stat .num {
        font-family: var(--font-display);
        font-size: clamp(3rem, 6vw, 4.6rem);
        line-height: 1;
        background: linear-gradient(120deg, var(--teal), var(--signal));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .stat .label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--muted);
        margin-top: 0.35rem;
      }

      .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin: 0 0 1.4rem;
      }

      .section-heading h2 {
        font-size: 1.9rem;
        margin: 0;
      }

      .section-heading a {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--teal);
        text-decoration: none;
      }

      .section-heading a:hover {
        color: #fff;
      }

      .featured-wrap {
        margin-bottom: 3rem;
      }

      .story-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
      }

      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--muted);
      }

      @media (max-width: 900px) {
        .story-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 700px) {
        .hero {
          grid-template-columns: 1fr;
        }
        .stat {
          text-align: left;
        }
      }

      @media (max-width: 480px) {
        .story-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="main-wide">
      <section class="hero">
        <div>
          <p class="kicker"><span class="live-dot"></span>Live transfer coverage</p>
          <h1>{SITE_TITLE}</h1>
          <p>{SITE_DESCRIPTION}</p>
        </div>
        {allPosts.length > 0 && (
          <div class="stat">
            <span class="num">{allPosts.length}</span>
            <span class="label">deals tracked · {clubCount} clubs</span>
          </div>
        )}
      </section>

      <div class="page-layout">
        <div class="main-col">
          {featured && (
            <section class="featured-wrap">
              <PostCard
                id={featured.id}
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                heroImage={featured.data.heroImage}
                tags={featured.data.tags}
                featured={true}
              />
            </section>
          )}

          {recent.length > 0 && (
            <section>
              <div class="section-heading">
                <h2>Latest news</h2>
                <a href="/blog">View all →</a>
              </div>
              <div class="story-grid">
                {recent.map((post) => (
                  <PostCard
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    heroImage={post.data.heroImage}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          )}

          {allPosts.length === 0 && (
            <div class="empty-state">
              <p>No transfer news yet — check back soon.</p>
            </div>
          )}
        </div>

        <Sidebar allPosts={allPosts} headlinePosts={moreHeadlines} />
      </div>
    </main>
    <Footer />
  </body>
</html>
