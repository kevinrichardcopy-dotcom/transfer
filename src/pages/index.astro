---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { slugifyTag } from '../utils/slugifyTag';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = allPosts[0];
const recent = allPosts.slice(1, 7);
const moreHeadlines = allPosts.slice(7, 13);

// Tally how often each tag/club appears so the sidebar can surface
// what's trending right now, most-mentioned first.
const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const trendingTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: 1160px;
      }

      .hero {
        padding: 3rem 0 2rem;
        text-align: center;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin: 0 0 0.6rem;
        color: #111827;
        letter-spacing: -0.02em;
      }

      .hero p {
        font-size: 1.1rem;
        color: #6b7280;
        max-width: 42rem;
        margin: 0 auto;
      }

      .live-dot {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: #16a34a;
        margin-right: 0.4rem;
        box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5);
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(22, 163, 74, 0); }
        100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); }
      }

      .section-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin: 2.5rem 0 1.25rem;
      }

      .section-heading h2 {
        font-size: 1.4rem;
        font-weight: 800;
        color: #111827;
        margin: 0;
      }

      .section-heading a {
        font-size: 0.9rem;
        font-weight: 600;
        color: #16a34a;
        text-decoration: none;
      }

      .section-heading a:hover {
        text-decoration: underline;
      }

      .featured-wrap {
        margin-bottom: 1rem;
      }

      .layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        gap: 2.5rem;
        align-items: start;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
      }

      .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #6b7280;
      }

      /* Sidebar */
      .sidebar {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        position: sticky;
        top: 84px;
      }

      .widget {
        background: #ffffff;
        border: 1px solid #eceef1;
        border-radius: 14px;
        padding: 1.25rem 1.35rem 1.4rem;
        box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06);
      }

      .widget h3 {
        margin: 0 0 1rem;
        font-size: 0.95rem;
        font-weight: 800;
        color: #111827;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .tag-cloud a {
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        background: #f3f4f6;
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
      }

      .tag-cloud a:hover {
        background: #16a34a;
        color: #ffffff;
      }

      .headline-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
      }

      .headline-list li {
        padding: 0.85rem 0;
        border-bottom: 1px solid #f1f2f4;
      }

      .headline-list li:first-child {
        padding-top: 0;
      }

      .headline-list li:last-child {
        padding-bottom: 0;
        border-bottom: none;
      }

      .headline-list a {
        text-decoration: none;
        color: #111827;
        font-size: 0.92rem;
        font-weight: 700;
        line-height: 1.4;
        display: block;
      }

      .headline-list a:hover {
        color: #16a34a;
      }

      .headline-list time {
        display: block;
        margin-top: 0.3rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #9ca3af;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .live-widget p {
        margin: 0 0 1rem;
        font-size: 0.88rem;
        line-height: 1.6;
        color: #4b5563;
      }

      .live-widget .live-badge {
        display: inline-flex;
        align-items: center;
        font-size: 0.78rem;
        font-weight: 700;
        color: #16a34a;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 0.75rem;
      }

      .follow-links {
        display: flex;
        gap: 0.6rem;
      }

      .follow-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 9999px;
        background: #f3f4f6;
        color: #4b5563;
        text-decoration: none;
        transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
      }

      .follow-links a:hover {
        color: #fff;
        background: linear-gradient(135deg, #7c3aed, #2563eb);
        transform: translateY(-2px);
      }

      @media (max-width: 1200px) {
        main {
          width: 100%;
        }
      }

      @media (max-width: 960px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .sidebar {
          position: static;
        }
      }

      @media (max-width: 900px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 640px) {
        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="hero">
        <p style="font-size: 0.85rem; font-weight: 600; color: #16a34a; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.75rem;">
          <span class="live-dot"></span>Live transfer coverage
        </p>
        <h1>{SITE_TITLE}</h1>
        <p>{SITE_DESCRIPTION}</p>
      </section>

      <div class="layout">
        <div class="main-col">
          {featured && (
            <section class="featured-wrap">
              <PostCard
                id={featured.id}
                title={featured.data.title}
                description={featured.data.description}
                pubDate={featured.data.pubDate}
                heroImage={featured.data.heroImage}
                tags={featured.data.tags}
                featured={true}
              />
            </section>
          )}

          {recent.length > 0 && (
            <section>
              <div class="section-heading">
                <h2>Latest news</h2>
                <a href="/blog/1/">View all →</a>
              </div>
              <div class="grid">
                {recent.map((post) => (
                  <PostCard
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    heroImage={post.data.heroImage}
                    tags={post.data.tags}
                  />
                ))}
              </div>
            </section>
          )}

          {allPosts.length === 0 && (
            <div class="empty-state">
              <p>No transfer news yet — check back soon.</p>
            </div>
          )}
        </div>

        <aside class="sidebar">
          <div class="widget live-widget">
            <span class="live-badge"><span class="live-dot"></span>On the ground</span>
            <p>Fresh confirmations, medicals and here-we-go's added as they break — refresh often during deadline day.</p>
            <div class="follow-links">
              <a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Follow on Twitter / X">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
                  ><path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
                  ></path></svg
                >
              </a>
              <a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
                  ><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                  ></path></svg
                >
              </a>
              <a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Connect on LinkedIn">
                <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
                  ><path fill="currentColor" d="M13.5 0h-11A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0zM4.94 13.5H2.5V6h2.44v7.5zM3.72 4.9a1.4 1.4 0 1 1 0-2.8 1.4 1.4 0 0 1 0 2.8zM13.5 13.5h-2.44V9.6c0-.93-.02-2.13-1.3-2.13-1.3 0-1.5 1.02-1.5 2.06v3.97H5.83V6h2.34v1.02h.03c.33-.62 1.13-1.28 2.33-1.28 2.49 0 2.95 1.64 2.95 3.77v3.99z"
                  ></path></svg
                >
              </a>
            </div>
          </div>

          {trendingTags.length > 0 && (
            <div class="widget">
              <h3>Trending clubs</h3>
              <div class="tag-cloud">
                {trendingTags.map(([tag]) => (
                  <a href={`/tag/${slugifyTag(tag)}/`}>{tag}</a>
                ))}
              </div>
            </div>
          )}

          {moreHeadlines.length > 0 && (
            <div class="widget">
              <h3>More headlines</h3>
              <ul class="headline-list">
                {moreHeadlines.map((post) => (
                  <li>
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    <FormattedDate date={post.data.pubDate} />
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </main>
    <Footer />
  </body>
</html>
