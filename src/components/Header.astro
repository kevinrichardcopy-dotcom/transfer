---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// The ticker pulls the newest headlines site-wide, so it stays
// current without anyone having to maintain it separately.
const latest = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 8);
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="brand-mark" aria-hidden="true"></span>
			{SITE_TITLE}
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>

	{latest.length > 0 && (
		<div class="ticker">
			<span class="ticker-tag"><span class="live-dot"></span>Live</span>
			<div class="ticker-track">
				<div class="ticker-content">
					{latest.map((post) => (
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					))}
				</div>
				<div class="ticker-content" aria-hidden="true">
					{latest.map((post) => (
						<a href={`/blog/${post.id}/`} tabindex="-1">{post.data.title}</a>
					))}
				</div>
			</div>
		</div>
	)}
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--navy);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		max-width: 1160px;
		margin: 0 auto;
		height: 60px;
		padding: 0 1.5em;
	}

	.brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		color: #ffffff;
	}

	.brand-mark {
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: var(--flare);
		margin-right: 0.55em;
	}

	.internal-links {
		display: flex;
		gap: 0.25em;
	}

	.internal-links :global(a) {
		position: relative;
		padding: 0.5em 0.9em;
		font-size: 0.95rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.65);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.internal-links :global(a:hover) {
		color: #ffffff;
	}

	.internal-links :global(a.active) {
		color: #ffffff;
		font-weight: 600;
	}

	.internal-links :global(a.active)::after {
		content: '';
		position: absolute;
		left: 0.9em;
		right: 0.9em;
		bottom: 0.3em;
		height: 2px;
		background: var(--flare);
	}

	.ticker {
		display: flex;
		align-items: stretch;
		background: var(--navy-light);
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		overflow: hidden;
	}

	.ticker-tag {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		padding: 0.55em 1em;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.03em;
		color: #ffffff;
		background: rgba(214, 67, 47, 0.16);
	}

	.ticker-track {
		display: flex;
		overflow: hidden;
		flex: 1;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
	}

	.ticker-content {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		animation: scroll-ticker 38s linear infinite;
	}

	.ticker-content a {
		white-space: nowrap;
		padding: 0.55em 2em 0.55em 0;
		font-size: 0.85rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		border-right: 1px solid rgba(255, 255, 255, 0.14);
		margin-right: 2em;
	}

	.ticker-content a:hover {
		color: #ffffff;
	}

	@keyframes scroll-ticker {
		from { transform: translateX(0); }
		to { transform: translateX(-100%); }
	}

	@media (prefers-reduced-motion: reduce) {
		.ticker-content {
			animation: none;
		}
		.ticker-content[aria-hidden='true'] {
			display: none;
		}
	}

	@media (max-width: 480px) {
		nav {
			height: auto;
			padding: 0.75em 1em;
			gap: 0.5em;
		}
		.internal-links {
			gap: 0;
		}
		.internal-links :global(a) {
			padding: 0.4em 0.6em;
			font-size: 0.88rem;
		}
	}
</style>
