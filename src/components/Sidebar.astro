---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { slugifyTag } from '../utils/slugifyTag';

interface Props {
  // Full set of posts, used to tally which tags/clubs come up most.
  allPosts: CollectionEntry<'blog'>[];
  // The posts to list under "More headlines" (caller decides which
  // slice makes sense — e.g. posts not already shown on the page).
  headlinePosts?: CollectionEntry<'blog'>[];
  // Slug of the tag currently being viewed, if any, so its pill
  // can be highlighted instead of just linking to itself.
  activeTagSlug?: string;
}

const { allPosts, headlinePosts = [], activeTagSlug } = Astro.props;

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const trendingTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);
---

<aside class="sidebar">
  <div class="widget live-widget">
    <span class="live-badge"><span class="live-dot"></span>On the ground</span>
    <p>Fresh confirmations, medicals and here-we-go's added as they break — refresh often during deadline day.</p>
    <div class="follow-links">
      <a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Follow on Twitter / X">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
          ><path fill="currentColor" d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
          ></path></svg
        >
      </a>
      <a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
          ><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path></svg
        >
      </a>
      <a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" aria-label="Connect on LinkedIn">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
          ><path fill="currentColor" d="M13.5 0h-11A2.5 2.5 0 0 0 0 2.5v11A2.5 2.5 0 0 0 2.5 16h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 13.5 0zM4.94 13.5H2.5V6h2.44v7.5zM3.72 4.9a1.4 1.4 0 1 1 0-2.8 1.4 1.4 0 0 1 0 2.8zM13.5 13.5h-2.44V9.6c0-.93-.02-2.13-1.3-2.13-1.3 0-1.5 1.02-1.5 2.06v3.97H5.83V6h2.34v1.02h.03c.33-.62 1.13-1.28 2.33-1.28 2.49 0 2.95 1.64 2.95 3.77v3.99z"
          ></path></svg
        >
      </a>
    </div>
  </div>

  {trendingTags.length > 0 && (
    <div class="widget">
      <h3>Trending clubs</h3>
      <div class="tag-cloud">
        {trendingTags.map(([tag]) => {
          const slug = slugifyTag(tag);
          return (
            <a href={`/tag/${slug}/`} class={slug === activeTagSlug ? 'active' : ''}>
              {tag}
            </a>
          );
        })}
      </div>
    </div>
  )}

  {headlinePosts.length > 0 && (
    <div class="widget">
      <h3>More headlines</h3>
      <ul class="headline-list">
        {headlinePosts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            <FormattedDate date={post.data.pubDate} />
          </li>
        ))}
      </ul>
    </div>
  )}
</aside>
