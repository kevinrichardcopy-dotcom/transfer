---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { slugifyTag } from '../utils/slugifyTag';
import { pickFallback } from '../utils/fallbackImage';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: any;
  tags?: string[];
  featured?: boolean;
}

const { id, title, description, pubDate, heroImage: postImage, tags = [], featured = false } = Astro.props;
const fallback = postImage ? null : pickFallback(id);
const heroImage = postImage ?? fallback!.src;
const contain = fallback?.contain ?? false;
---

{featured ? (
  <article class="feature">
    <a href={`/blog/${id}/`} class="feature-link">
      {heroImage && (
        <div class:list={['feature-image', { contain }]}>
          <Image width={1100} height={520} src={heroImage} alt="" />
        </div>
      )}
      <div class="feature-copy">
        <p class="date"><FormattedDate date={pubDate} /></p>
        <h2 class="title">{title}</h2>
        <p class="description">{description}</p>
      </div>
    </a>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <a href={`/tag/${slugifyTag(tag)}/`} class="tag-pill">{tag}</a>
        ))}
      </div>
    )}
  </article>
) : (
  <article class="card">
    <a href={`/blog/${id}/`} class="card-link">
      {heroImage && (
        <div class:list={['card-image', { contain }]}>
          <Image width={520} height={340} src={heroImage} alt="" />
        </div>
      )}
      <div class="card-copy">
        <p class="date"><FormattedDate date={pubDate} /></p>
        <h3 class="title">{title}</h3>
        <p class="description">{description}</p>
      </div>
    </a>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <a href={`/tag/${slugifyTag(tag)}/`} class="tag-pill">{tag}</a>
        ))}
      </div>
    )}
  </article>
)}

<style>
  .date {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--teal-dark);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag-pill {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--teal-dark);
    background: var(--teal-soft);
    border-radius: 999px;
    padding: 0.28rem 0.65rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .tag-pill:hover {
    background: var(--teal);
    color: #fff;
  }

  /* Featured story — the one big, bold moment: full-bleed photo,
     oversized display type overlaid straight on the image. */
  .feature {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .feature-link {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .feature-image {
    aspect-ratio: 20 / 9;
    background: var(--surface);
  }

  .feature-image.contain,
  .card-image.contain {
    background: radial-gradient(90% 90% at 50% 40%, #ffffff 0%, #dff0e9 100%);
  }

  .feature-image.contain :global(img),
  .card-image.contain :global(img) {
    object-fit: contain;
    padding: 0.6rem;
  }

  .feature-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  .feature-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3.5rem 2rem 1.75rem;
    background: linear-gradient(0deg, rgba(19, 39, 44, 0.96) 0%, rgba(19, 39, 44, 0.55) 65%, transparent 100%);
  }

  .feature-copy .date {
    color: #7fe3bf;
  }

  .feature .title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    color: #ffffff;
    max-width: 34rem;
  }

  .feature .description {
    margin: 0;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 1rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Grid cards — dark elevated surface, no white-card-on-white-page */
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 0.75rem;
    box-shadow: var(--shadow);
    height: 100%;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--teal);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .card-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface-raised);
  }

  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  .card-copy {
    padding: 0 0.4rem;
    flex: 1;
  }

  .card .title {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--ink);
  }

  .card .description {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card .tags {
    padding: 0 0.4rem 0.4rem;
  }
</style>
