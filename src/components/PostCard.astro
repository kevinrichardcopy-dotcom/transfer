---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { slugifyTag } from '../utils/slugifyTag';

interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: any;
  tags?: string[];
  featured?: boolean;
}

const { id, title, description, pubDate, heroImage, tags = [], featured = false } = Astro.props;
---

<div class={`card ${featured ? 'featured' : ''}`}>
  <a href={`/blog/${id}/`} class="card-link">
    {heroImage && (
      <div class="image-wrap">
        <Image width={featured ? 900 : 500} height={featured ? 420 : 280} src={heroImage} alt="" />
      </div>
    )}
    <div class="content">
      <p class="date">
        <FormattedDate date={pubDate} />
      </p>
      <h3 class="title">{title}</h3>
      <p class="description">{description}</p>
      <span class="read-more">Read more →</span>
    </div>
  </a>
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((tag) => (
        <a href={`/tag/${slugifyTag(tag)}/`} class="tag-pill">{tag}</a>
      ))}
    </div>
  )}
</div>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid #eceef1;
    box-shadow: 0 1px 3px rgba(16, 24, 40, 0.06);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    height: 100%;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgba(16, 24, 40, 0.1);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f2f3f5;
  }

  .image-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .content {
    padding: 1.1rem 1.25rem 0.9rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .date {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #16a34a;
  }

  .title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    line-height: 1.35;
    font-weight: 700;
    color: #111827;
  }

  .featured .title {
    font-size: 1.6rem;
  }

  .description {
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4b5563;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-more {
    margin-top: auto;
    font-size: 0.85rem;
    font-weight: 600;
    color: #16a34a;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0 1.25rem 1.1rem;
  }

  .tag-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: #374151;
    background: #f3f4f6;
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .tag-pill:hover {
    background: #16a34a;
    color: #ffffff;
  }
</style>
