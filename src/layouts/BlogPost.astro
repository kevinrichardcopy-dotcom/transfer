---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { pickFallback } from '../utils/fallbackImage';

type Props = CollectionEntry<'blog'>['data'] & { id?: string };

const { title, description, pubDate, updatedDate, heroImage, id } = Astro.props;

// Sidebar draws on the whole site so a reader lands on more news
// after finishing this article; leave out the post they're on.
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fallback = heroImage ? null : pickFallback(id);
const sidebarHeadlines = allPosts.filter((post) => post.id !== id).slice(0, 6);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
				overflow: hidden;
				border-radius: 24px;
				aspect-ratio: 2 / 1;
				/* dark teal backdrop so transparent hero art (sky, cut-outs) blends in */
				background: radial-gradient(120% 140% at 100% 0%, #1f4a50 0%, var(--ink-bg) 60%);
			}
			.hero-image.contain {
				background: radial-gradient(90% 90% at 50% 40%, #ffffff 0%, #dff0e9 100%);
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.hero-image.contain img {
				object-fit: contain;
				padding: 1rem;
			}
			.prose {
				width: 720px;
				max-width: 100%;
				margin: auto;
				padding: 1.5em 1em 0;
				color: #2c4247;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--signal);
			}
			.last-updated-on {
				font-style: italic;
				color: var(--muted);
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="main-wide">
			<div class="page-layout">
				<article>
					<div class:list={['hero-image', { contain: fallback?.contain }]}>
						<Image width={1020} src={heroImage ?? fallback!.src} alt="" />
					</div>
					<div class="prose">
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<hr />
						</div>
						<slot />
					</div>
				</article>

				<Sidebar allPosts={allPosts} headlinePosts={sidebarHeadlines} />
			</div>
		</main>
		<Footer />
	</body>
</html>

